@page
@model ChapanakitCare.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = "รายงาน PDF"; }
<section class="card">
    <div class="card-head"><div><h2>รายงานทางการ</h2><div class="muted">รูปแบบตารางอ้างอิงจากตัวอย่าง PNG; ดาวน์โหลดเป็น PDF ที่เลือกข้อความได้ วันที่แสดงเป็นพุทธศักราช</div></div></div>
</section>
<section class="grid three" style="margin-top:18px">
    <article class="card"><h2>รายงานสมาชิกแยกตามกลุ่ม</h2>
        <form method="get" asp-page-handler="MemberByManager"><input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /><input type="hidden" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /><label>กลุ่มสมาชิก<select name="groupNo" required><option value="">เลือกกลุ่ม</option>@foreach (var group in Model.ManagerGroups) { <option value="@group">@group</option> }</select></label><button class="button" type="submit">ดาวน์โหลด PDF</button></form>
    </article>
    <article class="card"><h2>รายงานสมาชิกประจำเดือน</h2><form method="get" asp-page-handler="Monthly"><label>เลือกเดือน<input type="month" name="month" value="@Model.DefaultMonth" required /></label><button class="button" type="submit">ดาวน์โหลด PDF</button></form></article>
    <article class="card"><h2>แบบ ส.ฌ.ก.๑</h2><form method="get" asp-page-handler="SakOne"><label>เลือกเดือน<input type="month" name="month" value="@Model.DefaultMonth" required /></label><button class="button" type="submit">ดาวน์โหลด PDF</button></form></article>
</section>
<div class="alert" style="margin-top:18px">ข้อมูลที่ยังไม่มีในฐานข้อมูล: ประเภทสมาชิก, ผู้จัดการศพ, ข้อมูลเปลี่ยนแปลงทั่วไป และสถานะให้ออก จะแสดงเป็น “-” หรือ 0 จนกว่าจะเพิ่มข้อมูลดังกล่าวในระบบ</div>
