@page
@model ChapanakitCare.Web.Pages.History.IndexModel
@{
    ViewData["Title"] = "ประวัติการเปลี่ยนแปลง";
}
<section class="card">
    <div class="card-head"><div><h2>รายการล่าสุด</h2><div class="muted">เก็บผู้ดำเนินการ เวลา และค่าเดิม–ค่าใหม่ เพื่อให้ตรวจสอบย้อนหลังได้</div></div></div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty">ยังไม่มีประวัติการเปลี่ยนแปลง</div>
    }
    @foreach (var item in Model.Items)
    {
        <article class="history-event">
            <div class="history-time">@item.Audit.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")<br />@item.Audit.ActorDisplayName</div>
            <div>
                <strong>@IndexModel.ActionLabel(item.Audit.Action)</strong>
                @if (item.Member is not null) { <span> · @item.Member.RunNo @item.Member.Title@item.Member.FirstName @item.Member.LastName</span> }
                @if (item.Changes.Count > 0)
                {
                    <ul class="changes">
                    @foreach (var change in item.Changes)
                    {
                        <li><strong>@change.FieldName</strong>: @(change.IsSensitive ? "ข้อมูลอ่อนไหวถูกเปลี่ยน" : $"{change.OldValueDisplay ?? "–"} → {change.NewValueDisplay ?? "–"}")</li>
                    }
                    </ul>
                }
            </div>
        </article>
    }
</section>
