<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Chapanakit Care</title>
    <link rel="icon" type="image/jpeg" href="~/images/association-deer-logo.jpg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="top-nav" aria-label="เมนูหลัก">
        <nav>
            <a asp-page="/Index">ภาพรวม</a>
            <div class="nav-menu">
                <button type="button" class="nav-menu-trigger" aria-haspopup="true" aria-controls="management-submenu">ระบบจัดการและบันทึกข้อมูล</button>
                <div class="nav-submenu" id="management-submenu">
                    <span class="muted">กำหนดผู้ประสานงาน <small>เร็ว ๆ นี้</small></span>
                    <a asp-page="/Members/Index">ทะเบียนสมาชิก</a>
                    <a asp-page="/Members/Create">เพิ่มสมาชิก</a>
                    <a asp-page="/Resignations/Index">ปรับสถานะสมาชิกลาออก</a>
                    <a asp-page="/Deaths/Index">ทะเบียนผู้เสียชีวิต</a>
                    <a asp-page="/Deaths/Create">บันทึกการเสียชีวิต</a>
                </div>
            </div>
            <a asp-page="/Reports/Index">ระบบรายงาน</a>
        </nav>
    </aside>
    <main>
        <header class="topbar">
            <div>
                <p class="eyebrow">อำเภอร้องกวาง จังหวัดแพร่</p>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="date-chip">@DateTime.Today.ToString("d MMMM yyyy")</div>
        </header>
        @if (TempData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
