@page
@model ChapanakitCare.Web.Pages.Deaths.IndexModel
@using System.Globalization
@{ ViewData["Title"] = "ทะเบียนผู้เสียชีวิต"; }
<section class="card">
    <div class="card-head">
        <div><h2>รายการเสียชีวิต @Model.Rows.Count รายการ</h2><div class="muted">ข้อมูลและใบมรณะบัตรที่ยืนยันแล้วเป็น snapshot แก้ไขไม่ได้</div></div>
        <a class="button danger" asp-page="Create">+ บันทึกการเสียชีวิต</a>
    </div>
</section>
<section class="card" style="margin-top:18px">
    <form method="get" class="filters">
        <label>ค้นหา<input asp-for="Search" placeholder="เลขกรณี เลขสมาชิก ชื่อ เลขประชาชน หรือเอกสาร" /></label>
        <label>วันที่บันทึกตั้งแต่<input asp-for="From" type="date" value="@(Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" /></label>
        <label>ถึงวันที่<input asp-for="To" type="date" value="@(Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" /></label>
        <label>ผลการพิจารณา<select asp-for="Decision"><option value="">ทั้งหมด</option><option value="payable">จ่าย</option><option value="nonpay">ไม่จ่าย</option></select></label>
        <button class="button secondary" type="submit">กรองรายการ</button>
        <a class="button secondary" asp-page="Index">ล้างตัวกรอง</a>
    </form>
    <p class="muted filter-summary">ตัวกรองปัจจุบัน: @Model.FilterSummary</p>
</section>
<section class="card" style="margin-top:18px;padding:0">
    <div class="table-wrap"><table><thead><tr>
        <th>เลขกรณี</th><th>เลขสมาชิก</th><th>ชื่อ</th><th>เลขประชาชน</th><th>กลุ่มสมาชิก</th><th>วันที่บันทึก</th><th>วันที่ในใบมรณะ</th>
        <th>เลขที่ใบมรณะบัตร</th><th>สาเหตุ</th><th>ผู้รับเงินสงเคราะห์</th><th>ผลพิจารณา</th><th>ผู้ร่วมจ่าย</th>
        <th>เรียกเก็บรวม</th><th>หักค่าใช้จ่าย 4%</th><th>สุทธิหลังหัก</th><th>คืนเงินล่วงหน้า</th><th>ผลประโยชน์รวม</th><th>เอกสาร</th>
    </tr></thead><tbody>
    @foreach (var row in Model.Rows)
    {
        var beneficiaries = Model.BeneficiariesByCase.GetValueOrDefault(row.Case.Id) ?? [];
        <tr>
            <td>@row.Case.DeathCaseNo</td><td>@row.Member.RunNo</td><td>@row.Member.Title@row.Member.FirstName @row.Member.LastName</td><td>@row.Member.PersonalIdCard</td><td>@row.Member.GroupNo</td>
            <td>@ChapanakitCare.Web.Pages.Members.IndexModel.ThaiDate(row.Case.RecordedBusinessDate)</td><td>@ChapanakitCare.Web.Pages.Members.IndexModel.ThaiDate(row.Case.DeathCertificateDate)</td>
            <td>@row.Case.DeathCertificateNo</td><td>@row.Case.CauseOfDeathText</td><td>@string.Join(" / ", beneficiaries.Select(value => $"{value.Title}{value.FirstName} {value.LastName}"))</td>
            <td>@(row.Case.IsManualNonPayCase ? $"เคสไม่จ่าย: {row.Case.ManualNonPayReason}" : row.Case.EligibilityResult == "payable" ? "จ่าย" : "ไม่จ่ายก่อนคุ้มครอง")</td>
            <td>@row.Calculation.ContributorCount</td><td>@((row.Calculation.GrossCollectionSatang / 100m).ToString("N2"))</td><td>@((row.Calculation.ServiceFeeSatang / 100m).ToString("N2"))</td><td>@((row.Calculation.NetCollectionSatang / 100m).ToString("N2"))</td><td>@((row.Calculation.DeceasedAdvanceValueSatang / 100m).ToString("N2"))</td><td>@((row.Calculation.TotalBenefitSatang / 100m).ToString("N2")) บาท</td>
            <td><a class="button secondary small" asp-page-handler="Certificate" asp-route-id="@row.Case.Id">ดาวน์โหลด PDF</a></td>
        </tr>
    }
    </tbody></table></div>
</section>
